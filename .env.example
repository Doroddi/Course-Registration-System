# Local development only. Copy to .env and choose a password.
POSTGRES_PASSWORD=replace-with-local-password
POSTGRES_PORT=5432

# Set this in the application process or IDE environment; bootRun does not load .env automatically.
# Development seed accounts only. No default password is supplied.
INITIAL_STUDENT_PASSWORD=

# Application environment overrides (defaults: 2026 / 2).
ENROLLMENT_YEAR=2026
ENROLLMENT_TERM=2

# Application/IDE environment: .env is not loaded automatically by bootRun.
# Base64-encode at least 32 cryptographically random bytes. No default key is provided.
JWT_SECRET_BASE64=
JWT_ISSUER=course-registration-system
JWT_AUDIENCE=course-registration-api
